      text-overflow: ellipsis;
      white-space: nowrap;
      letter-spacing: .01785714em;
      font-family: "Google Sans", Roboto, Arial, sans-serif;
      font-size: .875rem;
      font-weight: 500;
      line-height: 1.25rem;
      height: 36px;
      padding: 8px 24px;
      border-radius: 4px;
      display: inline-block;
    }

    div:hover {
      background-color: rgba(154, 160, 166, 0.039);
      cursor: pointer;
    }
  }
}

.modal-container .modal {
  top: 50%;
  max-height: calc(100vh - 96px);

  @media (max-width: 599px) {
    top: 64px;
    max-height: calc(100% - 64px);
  }
}

.label-modal-main {
  display: flex;
  flex-direction: column;
  max-height: min(720px, calc(100vh - 96px));
  overflow: hidden;

  .header {
    flex: 0 0 auto;
    padding: 15px 15px 8px;
  }

  .footer {
    flex: 0 0 auto;
    padding: 10px;
  }

  .label-list .labels-container .label-icon {
    background-color: #80868b;
    background-image: none;
    border-radius: 50%;
    mask-image: url(/assets/images/svg/trash-filled.svg);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: 18px 18px;
    -webkit-mask-image: url(/assets/images/svg/trash-filled.svg);
    -webkit-mask-position: center;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 18px 18px;
    opacity: 0.82;
    transition: background-color 0.12s ease, opacity 0.12s ease, transform 0.12s ease;
  }

  .label-list .labels-container .label-icon:hover {
    background-color: #d93025;
    opacity: 1;
    transform: scale(1.04);
  }

  @media (max-width: 599px) {
    max-height: 100%;
    height: 100%;
  }
}

.disabled {
  cursor: not-allowed !important;
  opacity: 0.25;
}

// Keep nav label/binder editing as a compact dialog on phones. The old mobile
// rule expanded this to a full-screen sheet, which collided with the sticky
// mobile navbar and floating actions.
.modal-container {
  align-items: center;
  justify-content: center;

  .modal {
    border-radius: 12px;
    height: auto;
    left: 50%;
    max-height: min(560px, calc(100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 48px));
    max-width: min(360px, calc(100vw - 32px));
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(360px, calc(100vw - 32px));

    @media (max-width: 599px) {
      border-radius: 12px;
      height: auto;
      max-height: min(520px, calc(100dvh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 48px));
      max-width: calc(100vw - 32px);
      top: 50%;
      transform: translate(-50%, -50%);
      width: calc(100vw - 32px);
    }
  }

  .label-modal-main {
    border-radius: 12px;
    max-height: inherit;

    .label-list {
      max-height: min(340px, 52dvh);
    }

    @media (max-width: 599px) {
      .header {
        padding: 14px 14px 6px;
      }

      .label-list {
        max-height: min(300px, 46dvh);
        padding: 0 14px 4px;
      }

      .footer {
        padding: 8px 10px;
      }
    }
  }
}

:host-context(.light-theme) {
  // Edit-labels modal: invert the dark surface for light mode.
  .modal-container { background-color: rgba(60, 64, 67, 0.4); }

  .label-modal-main {
    background-color: #fff;
    box-shadow: 0 1px 3px 0 rgb(60 64 67 / 30%), 0 4px 8px 3px rgb(60 64 67 / 15%);

    input {
      color: #202124;
    }

    input::placeholder {
      color: #5f6368;
    }

    input:focus {
      border-bottom-color: #dadce0;
    }

    .header {
      p {
        color: #202124;
      }

      .error {
        color: #d93025;
      }

      .labels-container {
        .label-icon,
        .pen-icon {
          filter: invert(1);
        }

        .trash-icon {
          background-color: #5f6368;
        }

        .label-icon:hover {
          background-color: #5f6368;
        }
      }

      .input-container {
        .plus-icon,
        .check-icon {
          filter: invert(1);
        }
      }

      .cancel-icon {
        filter: invert(1);
      }
    }

    .footer {
      border-top-color: #dadce0;

      div {
        color: #1a73e8;
      }
    }
  }
}

// Catalog ordering uses touch and keyboard controls in the existing edit dialogs.
.label-modal-main .label-list .binder-edit-row,
.label-modal-main .label-list .label-edit-row {
  input { margin: 0 8px; min-width: 0; width: 0; }
  .label-icon, .pen-icon { flex: 0 0 24px; }

  .catalog-drag-handle {
    background-color: currentColor;
    color: #e8eaed;
    cursor: grab;
    flex: 0 0 28px;
    height: 44px;
    mask: url(/assets/images/svg/move.svg) center / 18px 18px no-repeat;
    -webkit-mask: url(/assets/images/svg/move.svg) center / 18px 18px no-repeat;
    opacity: 0.54;
    touch-action: none;
    user-select: none;
    -webkit-touch-callout: none;
    &:active { cursor: grabbing; opacity: 0.87; }
  }

  &.catalog-drag-source {
    background: rgba(138, 180, 248, 0.08);
    border-radius: 6px;
    outline: 1px dashed #8ab4f8;
    outline-offset: -3px;
    > * { opacity: 0; }
  }

  .binder-move, .label-move {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 6px;
    color: #e8eaed;
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 36px;
    height: 44px;
    justify-content: center;
    padding: 0;

    .material-symbols-outlined { font-size: 20px; }
    &:hover:not(:disabled) { background: rgba(154, 160, 166, 0.12); }
    &:focus-visible { outline: 2px solid #8ab4f8; }
    &:disabled { cursor: default; opacity: 0.3; }
  }
}

.label-list.catalog-reordering > [data-catalog-name] {
  transition: transform 140ms ease;
}

@media (prefers-reduced-motion: reduce) {
  .label-list.catalog-reordering > [data-catalog-name] { transition: none; }
}

:host-context(.light-theme) .label-modal-main .label-list .binder-move,
:host-context(.light-theme) .label-modal-main .label-list .label-move,
:host-context(.light-theme) .label-modal-main .label-list .catalog-drag-handle { color: #3c4043; }

.main-sidebar.binder-drop-active .item.is-binder {
  outline: 1px dashed rgba(138, 180, 248, 0.5);
  outline-offset: -3px;
}

.main-sidebar.binder-drop-active .item.is-binder.binder-drop-target {
  background-color: #d2e3fc;
  color: #174ea6;
  outline: 2px solid #1a73e8;
  outline-offset: -3px;
}
